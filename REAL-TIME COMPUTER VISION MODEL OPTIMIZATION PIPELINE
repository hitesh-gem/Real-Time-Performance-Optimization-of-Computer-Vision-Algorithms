def get_model_size_mb(model, filepath="temp_model.p"):
    """Helper function to calculate model size on disk in MB."""
    torch.save(model.state_dict(), filepath)
    size_mb = os.path.getsize(filepath) / (1024 * 1024)
    if os.path.exists(filepath):
        os.remove(filepath)
    return size_mb

def benchmark_model(model, input_tensor, num_iterations=100, warmup=10):
    """Benchmarks model inference time and computes average FPS."""
    model.eval()
    
    # Warm-up runs to stabilize cache and frequency scaling
    with torch.no_grad():
        for _ in range(warmup):
            _ = model(input_tensor)
            
    start_time = time.time()
    with torch.no_grad():
        for _ in range(num_iterations):
            _ = model(input_tensor)
    end_time = time.time()
    
    total_time = end_time - start_time
    avg_latency_ms = (total_time / num_iterations) * 1000.0
    fps = num_iterations / total_time
    return avg_latency_ms, fps

